# Copy to .env and fill in. Do NOT commit .env.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/boonhrm"

# Better Auth — generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://your-domain.example.com"
APP_URL="https://your-domain.example.com"

# Shown in candidate email templates
COMPANY_NAME="Your Company"

# --- Outbound email ---------------------------------------------------------
# One provider is required in prod (login OTPs are emailed). Auto-detect:
# SMTP creds -> smtp, else MS_* -> graph, else console (dev only).
# Force explicitly with MAIL_PROVIDER=smtp|graph|console.
MAIL_PROVIDER=""

# Option A — standard Gmail via SMTP App Password (see docs/GMAIL-SETUP.md)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="<16-char Google App Password>"
MAIL_FROM="Your Company Recruitment <you@gmail.com>"

# Option B — Microsoft 365 Graph app-only (see docs/M365-SETUP.md); enables
# reply-threading (V2) via conversationId.
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
CAREERS_MAILBOX="careers@your-domain.example.com"

# First admin (seeded by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@your-domain.example.com"
SEED_ADMIN_NAME="Admin"

# Private storage for resumes/documents — an absolute path OUTSIDE the web root in prod
# (e.g. /var/www/vhosts/your-domain/private_storage/boonhrm).
PRIVATE_STORAGE_DIR="./.storage"
