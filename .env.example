# Copy to .env and fill in. Do NOT commit .env.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/boonhrm"

# Better Auth — generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://your-domain.example.com"
APP_URL="https://your-domain.example.com"

# Shown in candidate email templates
COMPANY_NAME="Your Company"

# Microsoft 365 Graph (app-only client credentials). Required in prod for OTP + emails.
# See docs/M365-SETUP.md for the Azure App Registration + RBAC-for-Applications steps.
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
CAREERS_MAILBOX="careers@your-domain.example.com"

# First admin (seeded by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@your-domain.example.com"
SEED_ADMIN_NAME="Admin"

# Private storage for resumes/documents — an absolute path OUTSIDE the web root in prod
# (e.g. /var/www/vhosts/your-domain/private_storage/boonhrm).
PRIVATE_STORAGE_DIR="./.storage"
